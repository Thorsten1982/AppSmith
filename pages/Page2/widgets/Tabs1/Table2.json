      "label": "Aktiv",
      "notation": "standard",
      "onCheckChange": "{{\n  (() => {\n    const stammdatenArray = Stammdaten.data || [];\n    const updatedRow = Table2.updatedRow || Table2.triggeredRow || {};\n    \n    // Passende Zeile im Stammdaten-Array suchen\n    const targetIdx = stammdatenArray.findIndex(r => \n      String(r.Haus || \"\").trim() === String(updatedRow.Haus || \"\").trim() &&\n      String(r.Bahn || \"\").trim() === String(updatedRow.Bahn || \"\").trim()\n    );\n\n    if (targetIdx === -1) {\n      return {};\n    }\n\n    // Google Sheets ist 1-basiert + 1 Header-Zeile -> Index + 2\n    return {\n      \"rowIndex\": targetIdx + 2,\n      \"Haus_Aktiv\": updatedRow.Aktiv\n    };\n  })()\n}}",
